# 量化回测数据缓存（parquet 快照，大文件，可从数据源重生，不入库）
intraday/data_cache/

# 回测运行时产物（每笔记录、原始结果输出等；可重生，不入库）
intraday/output/

# 临时产物目录（预览图、调试快照、一次性脚本等），不入库
tmp/

# Python 字节码缓存（本地生成，不入库）
__pycache__/
*.pyc

# node_modules 全局兜底
node_modules/

# 系统杂物
.DS_Store

# 产物接力目录（含可售卖成品，勿公开）
artifacts/

# 运行时数据目录
docs/

# 本机密钥通用兜底（保留 .env.example）
.env
.env.*
!.env.example

# 量化策略 tick/订单簿数据（Databento，大文件，已备份到 market-data-backup Release）
intraday/data_tick/

# 日内 ML 固化模型（LightGBM 文件，可由 train.py 重生）
intraday/models/

# 本地私有文件
*.local.md
